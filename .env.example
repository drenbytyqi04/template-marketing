# Supabase connection.
# Dashboard > Project Settings > Data API (URL) and API Keys.
#
# Copy this file to `.env` and fill in your own project's values.
# `.env` is gitignored - never commit real keys.

# Your project ref, e.g. abcdefghijklmnopqrst
SUPABASE_PROJECT_ID=""
SUPABASE_URL="https://<project-ref>.supabase.co"

# Publishable / anon key - safe to expose to the browser.
# Either the modern `sb_publishable_...` key or the legacy anon JWT.
SUPABASE_PUBLISHABLE_KEY=""

# VITE_* copies are what the browser bundle reads (see src/integrations/supabase/client.ts).
# Keep these identical to the three values above.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_URL="https://<project-ref>.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY=""

# SECRET - server-side only, bypasses row-level security.
# Read by src/integrations/supabase/client.server.ts. Never prefix this with VITE_
# and never commit it: doing so exposes full admin access to your database.
SUPABASE_SERVICE_ROLE_KEY=""

# --------------------------------------------------------------------------
# Instagram publishing (optional).
#
# Without these the app runs normally and the Instagram card says it is not
# configured; nothing crashes and nothing pretends to be connected.
#
# From your Meta app at https://developers.facebook.com/apps - Settings > Basic.
META_APP_ID=""
META_APP_SECRET=""

# Must match a Valid OAuth Redirect URI on the Meta app, exactly, including the
# scheme and any trailing path. The app derives it from the request origin, so
# register https://<your-domain>/api/public/oauth/meta - and the localhost form
# as well if you connect during development.
META_REDIRECT_URI="https://<your-domain>/api/public/oauth/meta"

# The Graph API version to call. Meta retires versions on a schedule, so this is
# configuration rather than something to edit in the source. Defaults to v21.0.
META_API_VERSION="v21.0"
